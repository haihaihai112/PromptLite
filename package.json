{
  "name": "promptlite",
  "version": "1.0.0",
  "description": "个人文本提示词工作台",
  "author": "haihaihai112",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json && node scripts/copy-preload.mjs",
    "start": "electron .",
    "dev": "vite --host 127.0.0.1",
    "desktop:dev": "node scripts/dev.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "44.7.2",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
